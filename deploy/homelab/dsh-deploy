#!/usr/bin/env bash
# Deploy DeepSeek Harness and its web plugins from GitHub to this host.
#
# Each harness commit on $HARNESS_BRANCH is built in its own worktree under $ROOT/releases/<sha>; $ROOT/current points at
# the live one and is dsh.service's WorkingDirectory. Each plugin in $PLUGINS is a clone at $ROOT/plugins/<name> installed
# into the dsh profile. New commits are built while dsh keeps running; the switch and restart wait until no session has
# written for $IDLE_MINUTES, then dsh must answer HTTP within $HEALTH_SECONDS or everything is rolled back.
#
# Run by dsh-deploy.timer. Manual: `dsh-deploy` (deploy when idle), `dsh-deploy --now` (skip the idle wait),
# `dsh-deploy --status`. Development checkouts under ~/apps (dsh's workspaces) are never touched.
set -euo pipefail

ROOT=${DSH_DEPLOY_ROOT:-$HOME/apps/dsh}
HARNESS_REMOTE=${HARNESS_REMOTE:-https://github.com/andershfranzen/deepseek-harness.git}
HARNESS_BRANCH=${HARNESS_BRANCH:-homelab}
# Space-separated <package name>=<git URL>; each deploys its main branch. A plugin removed from this list is uninstalled.
PLUGINS=${DSH_PLUGINS:-dsh-go=https://github.com/andershfranzen/dsh-go.git dsh-brand-a5=https://github.com/andershfranzen/dsh-brand-a5.git}
PLUGIN_BRANCH=${PLUGIN_BRANCH:-main}
PROFILE=${DSH_PROFILE:-web}
IDLE_MINUTES=${IDLE_MINUTES:-10}
HEALTH_SECONDS=${HEALTH_SECONDS:-120}
KEEP_RELEASES=${KEEP_RELEASES:-3}
PORT=${DSH_PORT:-3080}

REPO=$ROOT/repo
RELEASES=$ROOT/releases
PLUGINS_DIR=$ROOT/plugins
STATE=$ROOT/state
PROFILE_DIR=$HOME/.dsh/profiles/$PROFILE

log() { echo "[dsh-deploy] $*"; }
notify() { command -v ntfy-send >/dev/null && ntfy-send "$1" "$2" "${3:-3}" "${4:-}" || true; }
state() { cat "$STATE/$1" 2>/dev/null || true; }
# Plugin sets are "name@sha name@sha"; shorten the shas for messages.
short() { sed -E 's/@([0-9a-f]{7})[0-9a-f]+/@\1/g' <<<"$1"; }

mkdir -p "$RELEASES" "$STATE" "$PLUGINS_DIR"
exec 9>"$ROOT/.lock"
flock -n 9 || { log "another deploy is running"; exit 0; }

if [[ ${1:-} == --status ]]; then
  echo "current:  $(basename "$(readlink "$ROOT/current" 2>/dev/null || echo none)")"
  echo "plugins:  $(short "$(state plugin.deployed)")"
  echo "pending:  harness=$(state harness.pending) plugin=$(state plugin.pending)"
  echo "failed:   harness=$(state harness.failed) plugin=$(state plugin.failed)"
  exit 0
fi

# --- fetch -------------------------------------------------------------------------------------------------------------
# A regular clone without a checkout: the harness postinstall (lefthook) refuses worktrees of a bare repository.
[[ -d $REPO/.git ]] || git clone -q --no-checkout "$HARNESS_REMOTE" "$REPO"
# Network failures are transient: skip this run instead of alerting.
git -C "$REPO" fetch -q --prune origin "+refs/heads/$HARNESS_BRANCH:refs/remotes/origin/$HARNESS_BRANCH" || { log "harness fetch failed"; exit 0; }
want_h=$(git -C "$REPO" rev-parse "refs/remotes/origin/$HARNESS_BRANCH")

want_p=
for spec in $PLUGINS; do
  name=${spec%%=*} dir=$PLUGINS_DIR/${spec%%=*}
  [[ -d $dir/.git ]] || git clone -q --branch "$PLUGIN_BRANCH" "${spec#*=}" "$dir" || { log "$name clone failed"; exit 0; }
  git -C "$dir" fetch -q origin "$PLUGIN_BRANCH" || { log "$name fetch failed"; exit 0; }
  want_p+="$name@$(git -C "$dir" rev-parse FETCH_HEAD) "
done
want_p=${want_p% }

cur_h=$(basename "$(readlink "$ROOT/current" 2>/dev/null || echo none)")
cur_p=$(state plugin.deployed)
# State written before multi-plugin support holds a bare dsh-go sha.
[[ -n $cur_p && $cur_p != *@* ]] && cur_p="dsh-go@$cur_p"

# A commit that failed to build or start is skipped until the branch moves on.
[[ $want_h == "$(state harness.failed)" ]] && want_h=$cur_h
[[ $want_p == "$(state plugin.failed)" ]] && want_p=$cur_p
if [[ $want_h == "$cur_h" && $want_p == "$cur_p" ]]; then
  rm -f "$STATE/harness.pending" "$STATE/plugin.pending"
  exit 0
fi

# --- build the harness release off to the side ----------------------------------------------------------------------
release=$RELEASES/$want_h
if [[ $want_h != "$cur_h" && ! -e $release/.dsh-built ]]; then
  log "building harness ${want_h:0:10}"
  rm -rf "$release"
  git -C "$REPO" worktree prune
  git -C "$REPO" worktree add -q --detach "$release" "$want_h"
  if ! (cd "$release" && pnpm install --frozen-lockfile && pnpm run build) >"$release.build.log" 2>&1; then
    echo "$want_h" >"$STATE/harness.failed"
    tail -20 "$release.build.log"
    notify "dsh deploy: build failed" "Harness ${want_h:0:10} did not build; still running ${cur_h:0:10}. Log: $release.build.log" 4 warning
    exit 1
  fi
  touch "$release/.dsh-built"
  log "built harness ${want_h:0:10}"
fi
echo "$want_h" >"$STATE/harness.pending"
echo "$want_p" >"$STATE/plugin.pending"

# --- wait for idle ---------------------------------------------------------------------------------------------------
if [[ ${1:-} != --now ]] && find "$HOME/.dsh/sessions" -name 'session*.jsonl*' -mmin "-$IDLE_MINUTES" -print -quit 2>/dev/null | grep -q .; then
  log "update ready (harness ${want_h:0:10}, plugins $(short "$want_p")); waiting until sessions are idle for $IDLE_MINUTES min"
  exit 0
fi

# --- activate --------------------------------------------------------------------------------------------------------
install_plugins() { # $1 = plugin set, $2 = harness release dir that runs the dsh CLI
  local entry name managed=()
  for entry in $1; do
    name=${entry%@*}
    git -C "$PLUGINS_DIR/$name" -c advice.detachedHead=false checkout -q --force "${entry#*@}"
  done
  for entry in $PLUGINS $(state plugin.deployed); do managed+=("${entry%%[=@]*}"); done
  # Point the profile at exactly the plugins in the set (dependency + bundle row); drop other managed plugins.
  node -e '
    const [file, dir, set, ...managed] = process.argv.slice(1), p = require(file)
    const want = new Set(set.split(" ").filter(Boolean).map((e) => e.slice(0, e.lastIndexOf("@"))))
    const bundles = p.dsh.profile.bundles
    for (const name of new Set(managed)) {
      if (want.has(name)) {
        p.dependencies[name] = "file:" + dir + "/" + name
        if (!bundles.includes(name)) bundles.push(name)
      } else {
        delete p.dependencies[name]
        p.dsh.profile.bundles = bundles.filter((b) => b !== name)
      }
    }
    require("fs").writeFileSync(file, JSON.stringify(p, null, 2) + "\n")
  ' "$PROFILE_DIR/package.json" "$PLUGINS_DIR" "$1" "${managed[@]}"
  # pnpm keeps a stale copy of a file: dependency unless the copy and its install-state cache are removed.
  for name in "${managed[@]}"; do
    rm -rf "${PROFILE_DIR:?}/node_modules/$name" "$PROFILE_DIR"/node_modules/.pnpm/"$name"@*
  done
  rm -f "$PROFILE_DIR/node_modules/.pnpm-workspace-state-v1.json"
  (cd "$2" && pnpm dsh plugin --profile "$PROFILE" install)
}

healthy() {
  local deadline=$((SECONDS + HEALTH_SECONDS)) code
  while ((SECONDS < deadline)); do
    sleep 3
    systemctl is-active -q dsh || continue
    code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:$PORT/" || true)
    [[ $code == 200 || $code == 401 ]] && return 0
  done
  return 1
}

switch_to() { # $1 = harness sha, $2 = plugin set
  ln -sfn "releases/$1" "$ROOT/current.next" && mv -T "$ROOT/current.next" "$ROOT/current"
  install_plugins "$2" "$RELEASES/$1"
  sudo systemctl restart dsh
}

log "activating harness ${want_h:0:10}, plugins $(short "$want_p")"
if switch_to "$want_h" "$want_p" >>"$STATE/activate.log" 2>&1 && healthy; then
  echo "$want_p" >"$STATE/plugin.deployed"
  rm -f "$STATE/harness.pending" "$STATE/plugin.pending" "$STATE/harness.failed" "$STATE/plugin.failed"
  log "live: harness ${want_h:0:10}, plugins $(short "$want_p")"
  notify "dsh deployed" "Harness ${want_h:0:10}, $(short "$want_p")" 2 rocket
else
  log "dsh did not come up; rolling back to harness ${cur_h:0:10}, plugins $(short "$cur_p")"
  [[ $want_h != "$cur_h" ]] && echo "$want_h" >"$STATE/harness.failed"
  [[ $want_p != "$cur_p" ]] && echo "$want_p" >"$STATE/plugin.failed"
  if [[ -d $RELEASES/$cur_h && -n $cur_p ]] && switch_to "$cur_h" "$cur_p" >>"$STATE/activate.log" 2>&1 && healthy; then
    notify "dsh deploy rolled back" "Harness ${want_h:0:10} / $(short "$want_p") did not start; back on ${cur_h:0:10} / $(short "$cur_p"). See journalctl -u dsh" 4 warning
  else
    notify "dsh is DOWN" "Deploy of ${want_h:0:10} failed and rollback did not recover. See journalctl -u dsh -u dsh-deploy" 5 rotating_light
  fi
  exit 1
fi

# --- prune old releases (keep the newest $KEEP_RELEASES built ones, always including current) ----------------------
live=$(readlink -f "$ROOT/current")
ls -1dt "$RELEASES"/*/ 2>/dev/null | sed 's:/$::' | tail -n "+$((KEEP_RELEASES + 1))" | while read -r old; do
  [[ $old == "$live" ]] && continue
  git -C "$REPO" worktree remove --force "$old" 2>/dev/null || rm -rf "$old"
  rm -f "$old.build.log"
done
git -C "$REPO" worktree prune
